{
  "name": "agent-ops",
  "version": "1.2.1",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "description": "Agent Ops desktop work ledger",
  "main": "out/main/index.cjs",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "electron-vite build",
    "smoke": "playwright test --config electron-tests/playwright.config.ts",
    "package": "node scripts/release/package.mjs",
    "package:dir": "node scripts/release/package.mjs --dir",
    "smoke:packaged": "node scripts/release/smoke-packaged.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
